{
  "name": "signals-japan-insight",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAI Signals の公開集計を日本の視点から読み解く非公式・独立のダッシュボード",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p scripts",
    "test": "vitest run",
    "data:fetch": "node scripts/data/fetch.ts",
    "data:build": "node scripts/data/build.ts",
    "data:verify": "node scripts/data/verify.ts",
    "data": "npm run data:fetch && npm run data:build && npm run data:verify",
    "data:labels": "node scripts/data/extract-iwa-labels.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.5",
    "fflate": "^0.8.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
